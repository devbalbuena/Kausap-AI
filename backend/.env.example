# ──────────────────────────────────────────────
# Kausap AI — Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# JWT secret key — generate a strong random string for production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-replace-with-a-strong-random-string

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Fallback AI providers (Optional)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Voice Synthesis (Optional)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Brevo Transactional Email (Required for 6-Digit OTP, Counselor Provisioning & Guidance Call-Slips)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Kausap AI - Guidance & Counseling Office
